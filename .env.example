# Use a non-production Neon branch for local development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.us-east-2.aws.neon.tech/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech/DATABASE?sslmode=require"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/auth/continue"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/auth/continue"
PRIVATE_STORAGE_PROVIDER="local"
PRIVATE_STORAGE_DIR=".local-data/private"
QUOTE_RATE_LIMIT_SALT="replace-with-a-random-production-secret"
TRUST_PROXY_HEADERS="false"
TRUSTED_CLIENT_IP_HEADER="x-forwarded-for"
EMAIL_TRANSPORT="development"
EMAIL_FROM="LocalAction Quotes <quotes@example.com>"
# RESEND_API_KEY="re_..."
# SERPAPI_API_KEY="..."

# Paddle Billing. Use one environment consistently; never commit real values.
# PADDLE_API_KEY="pdl_sdbx_apikey_..."
# PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_..."
# NEXT_PUBLIC_PADDLE_PRICE_ID="pri_..."
# NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"

# Neon Object Storage (required with PRIVATE_STORAGE_PROVIDER="neon")
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_ENDPOINT_URL_S3="https://storage.<region>.neon.build"
# AWS_REGION="us-east-2"
