{
  "name": "google-maps-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/reset-test-database.ts",
    "email:retry": "tsx scripts/retry-email-deliveries.ts",
    "config:check": "tsx scripts/check-production-config.ts",
    "ops": "tsx scripts/private-beta-operations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "@prisma/client": "6.19.3",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "3.0.2",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.40.0",
    "maplibre-gl": "^6.7.0",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "sharp": "^0.35.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "3.7.4",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "^4.1.11"
  }
}
